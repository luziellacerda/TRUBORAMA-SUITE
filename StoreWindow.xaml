<Window x:Class="TurboBoxManager.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TURBORAMA • RETRO SYSTEMS"
        Icon="Assets/turborama-app-icon.ico"
        Width="1380" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#070907"
        Foreground="#F4F7F1"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Color x:Key="LimeColor">#9DFF00</Color>
        <Color x:Key="BlueColor">#2389FF</Color>
        <Color x:Key="RedColor">#FF3548</Color>
        <SolidColorBrush x:Key="LimeBrush" Color="{StaticResource LimeColor}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8E988C"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#0E120E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#293027"/>
        <BitmapImage x:Key="CatalogFallbackArtwork"
                     UriSource="Assets/f15-turborama-user-original-v13.png"
                     DecodePixelWidth="512"
                     CacheOption="OnLoad"
                     CreateOptions="DelayCreation"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="#0B0E0B"/>
            <Setter Property="Foreground" Value="#34402E"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#AAB2A6"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#182016"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="#091004"/><Setter Property="Background" Value="{StaticResource LimeBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B4FF3C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="#EDF1EA"/><Setter Property="Background" Value="#171C17"/><Setter Property="BorderBrush" Value="#30382D"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource LimeBrush}"/><Setter Property="Foreground" Value="{StaticResource LimeBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SidebarNavStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/><Setter Property="Padding" Value="15,0"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="#A6AFA2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><Grid><Rectangle x:Name="Marker" Width="3" RadiusX="2" Fill="{StaticResource LimeBrush}" HorizontalAlignment="Left" Opacity="0"/><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#151B14"/><Setter Property="Foreground" Value="White"/><Setter TargetName="Marker" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PageNumberButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Width" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0"/></Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelSurface}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="44,0,14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#111511"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="{StaticResource LimeBrush}"/>
            <Setter Property="BorderBrush" Value="#2A3128"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><Grid><TextBlock Text="⌕" FontSize="22" Foreground="#768072" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BlueBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <DataTemplate x:Key="RetroCategoryTemplate">
            <Button Tag="{Binding Id}" Click="Category_Click" AutomationProperties.Name="{Binding DisplayName}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1" HorizontalContentAlignment="Stretch" Cursor="Hand">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CategorySurface" CornerRadius="8" Background="Transparent" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="7" Background="#172016" BorderBrush="{Binding AccentBrush}" BorderThickness="1"><TextBlock Text="{Binding Glyph}" Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#AAB3A6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding ShortCode}" Foreground="#596354" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategorySurface" Property="Background" Value="#151C14"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="CategorySurface" Property="Background" Value="#1A2515"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CatalogCardTemplate">
            <Border x:Name="CardShell" Margin="7" MinHeight="342" Background="#111511" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True" RenderTransformOrigin=".5,.5" Cursor="Hand">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="CardGlow" Color="#7EFF00" BlurRadius="10" ShadowDepth="0" Opacity=".14"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="176"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="CardCoverFrame" ClipToBounds="True" Background="#0B100B">
                        <Image x:Name="CardCoverFallback"
                               Source="{StaticResource CatalogFallbackArtwork}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False"/>
                        <Image x:Name="CardCoverImage"
                               Source="{Binding ImageSource, IsAsync=True}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="{Binding ImageAltText}"
                               AutomationProperties.HelpText="Capa específica deste item">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageSource}" Value=""><Setter Property="Opacity" Value="0"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}"><Setter Property="Opacity" Value="0"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Border x:Name="CardCoverLoading" Background="#62070A07">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageSource}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemGlyph}" Foreground="{Binding AccentBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="CAPA TURBORAMA" Foreground="#BEC7BA" FontSize="8" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#08000000" Offset="0"/>
                                    <GradientStop Color="#30000000" Offset=".5"/>
                                    <GradientStop Color="#F2080C08" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-145,-90,0" IsHitTestVisible="False" Opacity=".42">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#907EFF00" Offset="0"/>
                                    <GradientStop Color="#007EFF00" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Rectangle x:Name="CardShimmer" Width="90" Height="310" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#38FFFFFF" Offset=".5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-18"/>
                                    <TranslateTransform x:Name="ShimmerTranslate" X="-130"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="5" Background="#DF070B08" BorderBrush="{Binding AccentBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding AccentBrush}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="5" Background="#E0070B08">
                            <TextBlock Text="{Binding Size}" Foreground="#F4F7F1" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <Grid VerticalAlignment="Bottom" Height="34" Margin="10,0,10,9">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="T U R B O R A M A" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                <Border Background="#C9090E09" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,-3">
                                    <TextBlock Text="{Binding SystemCode}" Foreground="{Binding AccentBrush}" FontSize="8" FontWeight="Black"/>
                                </Border>
                            </StackPanel>
                            <Rectangle Height="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-2"/>
                            <Rectangle Width="18" Height="2" Fill="{StaticResource RedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-2"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Version}" Foreground="{Binding AccentBrush}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock DockPanel.Dock="Right" Text="VERIFICADO" Foreground="#667063" FontSize="8" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock x:Name="CardDownloadStatus" Grid.Row="3" Text="{Binding DownloadStatus}" Foreground="#98A493" FontSize="9" Margin="0,5,0,5" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="CardDownloadProgress" Grid.Row="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" Foreground="{Binding AccentBrush}" Background="#222A20" BorderThickness="0" Height="4" VerticalAlignment="Center">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Opacity" Value=".32"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Grid Grid.Row="5" Margin="0,7,0,0">
                            <Button x:Name="CardDownloadButton" Content="{Binding DownloadActionLabel}" Tag="{Binding Id}" Click="DownloadItem_Click" AutomationProperties.Name="{Binding DownloadActionLabel}" AutomationProperties.HelpText="{Binding Title}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="CardCancelButton" Content="CANCELAR DOWNLOAD" Tag="{Binding Id}" Click="DownloadItem_Click" AutomationProperties.Name="Cancelar download" AutomationProperties.HelpText="{Binding Title}" Foreground="#FF7180" BorderBrush="#7A2932">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="CardOpenButton" Content="ABRIR ARQUIVO  ✓" Tag="{Binding Id}" Click="DownloadItem_Click" AutomationProperties.Name="Abrir arquivo baixado" AutomationProperties.HelpText="{Binding Title}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter" SourceName="CardShell">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:.18"/>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:.18"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To=".58" Duration="0:0:.2"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="24" Duration="0:0:.2"/>
                            <DoubleAnimation Storyboard.TargetName="CardShimmer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.12" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="ShimmerTranslate" Storyboard.TargetProperty="X" From="-130" To="520" Duration="0:0:.65"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave" SourceName="CardShell">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:.2"/>
                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:.2"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To=".14" Duration="0:0:.2"/>
                            <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DownloadJobTemplate">
            <Border Background="#101510" BorderBrush="#293228" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="15,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#172312" BorderBrush="#3B542E" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock Text="⇩" Foreground="{StaticResource LimeBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,18,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <Border DockPanel.Dock="Right" Background="#192219" CornerRadius="4" Padding="7,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource LimeBrush}" FontSize="8" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Category}" Foreground="#727D6F" FontSize="9" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#AAB4A6" FontSize="10" Margin="0,5,0,5" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" Foreground="{StaticResource LimeBrush}" Background="#232B20" BorderThickness="0" Height="4"/>
                    </Grid>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="DownloadJobCancelButton" Content="CANCELAR" Tag="{Binding}" Click="CancelDownloadJob_Click" AutomationProperties.Name="Cancelar download" AutomationProperties.HelpText="{Binding Title}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button x:Name="DownloadJobOpenButton" Content="ABRIR PASTA  ✓" Tag="{Binding}" Click="OpenDownloadJob_Click" AutomationProperties.Name="Abrir download" AutomationProperties.HelpText="{Binding Title}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PageNumberTemplate">
            <Button Content="{Binding Number}" Tag="{Binding Page}" IsEnabled="{Binding IsEnabled}" Click="SelectPage_Click" AutomationProperties.Name="{Binding Number}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PageNumberButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{StaticResource BlueBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger><DataTrigger Binding="{Binding IsEllipsis}" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#6A7466"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#070907" BorderBrush="#323A2F" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#080A08" BorderBrush="#222820" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" AutomationProperties.Name="Barra de título Turborama">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0"><Image Source="Assets/turborama-app-icon.ico" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="TURBORAMA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/><Rectangle Width="1" Height="15" Fill="#394035" Margin="11,0"/><TextBlock Text="CENTRAL DE SISTEMAS" FontSize="10" FontWeight="SemiBold" Foreground="#778173" VerticalAlignment="Center"/><Ellipse Width="5" Height="5" Fill="{StaticResource LimeBrush}" Margin="11,0,0,0"><Ellipse.Effect><DropShadowEffect Color="#9DFF00" BlurRadius="10" ShadowDepth="0"/></Ellipse.Effect></Ellipse></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" AutomationProperties.Name="Minimizar" Style="{StaticResource WindowButtonStyle}"/><Button Content="□" Click="Maximize_Click" AutomationProperties.Name="Maximizar ou restaurar" Style="{StaticResource WindowButtonStyle}"/><Button Content="×" Click="Close_Click" AutomationProperties.Name="Fechar" Style="{StaticResource WindowButtonStyle}" Foreground="#FF6B79"/></StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0A0D0A" BorderBrush="#20261E" BorderThickness="0,0,1,0">
                    <Grid Margin="13,14,10,12"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                        <Border Background="#111710" BorderBrush="#283325" BorderThickness="1" CornerRadius="12" Padding="11,8"><Grid><Image Source="Assets/turborama-logo-v3.png" Stretch="Uniform" HorizontalAlignment="Left" Width="188"/><Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#13200E" BorderBrush="#31482A" BorderThickness="1" CornerRadius="4" Padding="6,3"><TextBlock Text="ONLINE" Foreground="{StaticResource LimeBrush}" FontSize="8" FontWeight="Bold"/></Border></Grid></Border>
                        <StackPanel Grid.Row="1" Margin="0,19,0,0"><TextBlock Text="NAVEGAÇÃO" Foreground="#596254" FontSize="9" FontWeight="Bold" Margin="14,0,0,7"/><Button Content="⌂    Início" Tag="Home" Click="Nav_Click" AutomationProperties.Name="Início" Style="{StaticResource SidebarNavStyle}"/><Button Content="▦    Biblioteca" Tag="Library" Click="Nav_Click" AutomationProperties.Name="Biblioteca" Style="{StaticResource SidebarNavStyle}"/><Button Content="⇩    Downloads" Tag="Downloads" Click="Nav_Click" AutomationProperties.Name="Downloads" Style="{StaticResource SidebarNavStyle}"/></StackPanel>
                        <Grid Grid.Row="2" Margin="14,17,7,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SISTEMAS E COLEÇÕES" Foreground="#596254" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#182216" CornerRadius="5" Padding="6,3"><TextBlock Text="22" Foreground="{StaticResource LimeBrush}" FontSize="8" FontWeight="Bold"/></Border></Grid>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-4,5"><ItemsControl x:Name="RetroCategoryList" ItemsSource="{Binding CatalogCategories}" ItemTemplate="{StaticResource RetroCategoryTemplate}" AutomationProperties.Name="Lista de sistemas retrô"/></ScrollViewer>
                        <Border Grid.Row="4" Background="#111610" BorderBrush="#293226" BorderThickness="1" CornerRadius="11" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#1D2A17" BorderBrush="#3C542E" BorderThickness="1"><TextBlock Text="T" Foreground="{StaticResource LimeBrush}" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,1,0,0"><TextBlock Text="Piloto Turborama" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Licença ativa" Foreground="#68CA3B" FontSize="9" Margin="0,3,0,0"/></StackPanel><Ellipse Grid.Column="2" Width="6" Height="6" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/></Grid></Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.Background><RadialGradientBrush Center=".84,.13" GradientOrigin=".84,.13" RadiusX=".82" RadiusY=".82"><GradientStop Color="#172310" Offset="0"/><GradientStop Color="#080A08" Offset=".42"/><GradientStop Color="#070907" Offset="1"/></RadialGradientBrush></Grid.Background>

                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Página inicial">
                        <StackPanel Margin="30,26,24,36">
                            <Grid Margin="3,0,3,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Rectangle Width="4" Height="30" RadiusX="2" Fill="{StaticResource LimeBrush}" Margin="0,1,12,0"><Rectangle.Effect><DropShadowEffect Color="#9DFF00" BlurRadius="13" ShadowDepth="0"/></Rectangle.Effect></Rectangle><StackPanel><TextBlock Text="Central Turborama" FontSize="27" FontWeight="Bold"/><TextBlock Text="Sistemas, utilitários e coleções organizados em um só lugar" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="ABRIR PASTA" Click="OpenInstallFolder_Click" AutomationProperties.Name="Abrir pasta de instalação" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"/><Button Content="SUPORTE" Click="Support_Click" AutomationProperties.Name="Abrir suporte" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
                            <Border Height="348" CornerRadius="18" BorderBrush="#466232" BorderThickness="1" ClipToBounds="True"><Grid><Image Source="Assets/f15-turborama-user-original-v13.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FC070A07" Offset="0"/><GradientStop Color="#E5080C08" Offset=".38"/><GradientStop Color="#8E061006" Offset=".64"/><GradientStop Color="#20000000" Offset="1"/></LinearGradientBrush></Border.Background></Border><Canvas IsHitTestVisible="False"><Ellipse Width="420" Height="420" Canvas.Left="700" Canvas.Top="-40" Stroke="#5C9DFF00" StrokeThickness="1"/><Ellipse Width="315" Height="315" Canvas.Left="752" Canvas.Top="12" Stroke="#4C2389FF" StrokeThickness="2" StrokeDashArray="2 7"/><Line X1="665" Y1="347" X2="1020" Y2="0" Stroke="#4C9DFF00" StrokeThickness="1"/></Canvas><StackPanel Width="520" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0"><Border HorizontalAlignment="Left" Background="#361317" BorderBrush="#7A2832" BorderThickness="1" CornerRadius="6" Padding="10,5"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource RedBrush}" Margin="0,0,7,0"/><TextBlock Text="TURBORAMA RETRO SYSTEMS" Foreground="#FF6D7A" FontSize="9" FontWeight="Bold"/></StackPanel></Border><TextBlock Text="TODAS AS GERAÇÕES.&#x0a;UMA SÓ CENTRAL." FontSize="36" FontWeight="Black" LineHeight="39" Margin="0,15,0,0"/><TextBlock Text="Navegue por sistemas clássicos, pacotes organizados e perfis Turborama com busca, paginação e instalação centralizada." Foreground="#B8C2B4" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,13,0,20"/><StackPanel Orientation="Horizontal"><Button Content="EXPLORAR SISTEMAS  →" Click="OpenFirstCatalog_Click" AutomationProperties.Name="Explorar sistemas" Style="{StaticResource PrimaryButtonStyle}"/><Border Margin="13,0,0,0" Background="#B4090D09" BorderBrush="#364132" BorderThickness="1" CornerRadius="8" Padding="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="22" Foreground="{StaticResource BlueBrush}" FontSize="17" FontWeight="Black"/><TextBlock Text="  SISTEMAS" Foreground="#AFB7AB" FontSize="9" FontWeight="Bold"/></StackPanel></Border></StackPanel></StackPanel></Grid></Border>
                            <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="#172611" BorderBrush="#3E622A" BorderThickness="1"><TextBlock Text="⚡" Foreground="{StaticResource LimeBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Instalação organizada" FontSize="13" FontWeight="Bold"/><TextBlock Text="Pasta principal e temporários separados" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="#101E2D" BorderBrush="#265D96" BorderThickness="1"><TextBlock Text="⌕" Foreground="{StaticResource BlueBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Busca instantânea" FontSize="13" FontWeight="Bold"/><TextBlock Text="Encontre pacotes por nome ou versão" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="#2A1115" BorderBrush="#6A2831" BorderThickness="1"><TextBlock Text="✓" Foreground="{StaticResource RedBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Catálogo verificado" FontSize="13" FontWeight="Bold"/><TextBlock Text="Manifesto próprio da plataforma Turborama" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="LibraryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Página Biblioteca">
                        <StackPanel Margin="32,28,28,38"><StackPanel Orientation="Horizontal"><Rectangle Width="4" Height="31" RadiusX="2" Fill="{StaticResource BlueBrush}" Margin="0,1,12,0"/><StackPanel><TextBlock Text="Minha biblioteca" FontSize="27" FontWeight="Bold"/><TextBlock Text="Pacotes instalados e sistemas adicionados à sua coleção" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,25,0,0" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sua central está pronta" FontSize="22" FontWeight="Bold"/><TextBlock Text="Os pacotes baixados aparecerão aqui, organizados por sistema." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="EXPLORAR CATÁLOGO" Click="OpenFirstCatalog_Click" AutomationProperties.Name="Explorar catálogo" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Border>
                            <Border Height="390" Style="{StaticResource PanelBorderStyle}" Margin="0,18,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="112" Height="112"><Ellipse Fill="#142011" Stroke="#364B2C" StrokeThickness="1"/><Ellipse Width="77" Height="77" Stroke="{StaticResource LimeBrush}" StrokeThickness="2" StrokeDashArray="2 5"/><TextBlock Text="▦" Foreground="{StaticResource LimeBrush}" FontSize="37" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="Biblioteca vazia" FontSize="23" FontWeight="Bold" Margin="0,21,0,7"/><TextBlock Text="Escolha um sistema e adicione seu primeiro pacote Turborama." Foreground="{StaticResource MutedBrush}"/><Button Content="VER SISTEMAS  →" Click="OpenFirstCatalog_Click" AutomationProperties.Name="Ver sistemas" Style="{StaticResource SecondaryButtonStyle}" Margin="0,22,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="DownloadsPage" Visibility="Collapsed" Margin="32,28,28,32" AutomationProperties.Name="Página Downloads">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="31" RadiusX="2" Fill="{StaticResource RedBrush}" Margin="0,1,12,0"/>
                                <StackPanel><TextBlock Text="Central de downloads" FontSize="27" FontWeight="Bold"/><TextBlock Text="Fila real, progresso e histórico de transferências" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="LIMPAR CONCLUÍDOS" Click="ClearDownloadHistory_Click" IsEnabled="{Binding HasDownloads}" AutomationProperties.Name="Limpar histórico de downloads" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelBorderStyle}" Padding="18,15">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" Background="#182312" BorderBrush="#3A542C" BorderThickness="1"><TextBlock Text="⇩" Foreground="{StaticResource LimeBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Margin="13,1,0,0"><TextBlock Text="FILA DE TRANSFERÊNCIAS" Foreground="#687363" FontSize="9" FontWeight="Bold"/><TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"><Run Text="{Binding DownloadJobs.Count, Mode=OneWay}"/><Run Text="  downloads registrados"/></TextBlock></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="12,0,0,0" Padding="18,15">
                                <StackPanel><TextBlock Text="CONTROLE DE REDE" Foreground="#687363" FontSize="9" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse Width="8" Height="8" Fill="{StaticResource LimeBrush}" VerticalAlignment="Center"/><TextBlock Text="1 download por vez" FontSize="13" FontWeight="Bold" Margin="9,0,0,0"/></StackPanel></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,17,0,0">
                            <Border Visibility="{Binding DownloadsEmptyVisibility}" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="96" Height="96"><Ellipse Fill="#131B11" Stroke="#2F3C2A" StrokeThickness="1"/><Path Data="M19,48 L39,68 L78,25" Stroke="{StaticResource LimeBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
                                    <TextBlock Text="Nenhum download registrado" FontSize="21" FontWeight="Bold" Margin="0,19,0,7"/>
                                    <TextBlock Text="Escolha um pacote no catálogo para iniciar a fila." Foreground="{StaticResource MutedBrush}"/>
                                    <Button Content="EXPLORAR SISTEMAS" Click="OpenFirstCatalog_Click" AutomationProperties.Name="Explorar sistemas" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="DownloadJobsHost"
                                     ItemsSource="{Binding DownloadJobs}"
                                     ItemTemplate="{StaticResource DownloadJobTemplate}"
                                     Visibility="{Binding DownloadsListVisibility}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Fila de downloads">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <Grid x:Name="CatalogPage" Visibility="Collapsed" AutomationProperties.Name="Página do catálogo"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="32,25,28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Rectangle Width="4" Height="40" RadiusX="2" Fill="{StaticResource BlueBrush}" Margin="0,2,13,0"><Rectangle.Effect><DropShadowEffect Color="#2389FF" BlurRadius="12" ShadowDepth="0"/></Rectangle.Effect></Rectangle><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="CatalogPageTitle" Text="Sistemas retrô" FontSize="27" FontWeight="Bold"/><Border Background="#19231A" BorderBrush="#314031" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="11,3,0,0" VerticalAlignment="Top"><TextBlock x:Name="CatalogSystemCode" Text="RETRO" Foreground="{StaticResource LimeBrush}" FontSize="8" FontWeight="Bold"/></Border></StackPanel><TextBlock x:Name="CatalogPageDescription" Text="Escolha um pacote e baixe com um clique" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="▣  ABRIR PASTA" Click="OpenInstallFolder_Click" AutomationProperties.Name="Abrir pasta de instalação" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"/><Button Content="●  SUPORTE" Click="Support_Click" AutomationProperties.Name="Abrir suporte" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
                        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="32,0,28,17" Padding="18,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions><TextBlock Text="▣" Foreground="{StaticResource BlueBrush}" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="PASTA DE INSTALAÇÃO" Foreground="#687263" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="InstallFolderPath" Text="Documentos\Turborama" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="ALTERAR PASTA" Click="ChooseInstallFolder_Click" AutomationProperties.Name="Alterar pasta de instalação" Style="{StaticResource SecondaryButtonStyle}"/></Grid><Rectangle Grid.Row="1" Height="1" Fill="#252C23" Margin="0,12"/><Grid Grid.Row="2" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="105"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="↔" Foreground="{StaticResource LimeBrush}" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="PASTA DOS TEMPORÁRIOS" Foreground="#687263" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="TempFolderPath" Text="(padrão do sistema)" Foreground="#D4DAD0" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="ALTERAR" Click="ChooseTempFolder_Click" AutomationProperties.Name="Alterar pasta temporária" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Grid.Column="3" Content="PADRÃO" Click="ResetTempFolder_Click" AutomationProperties.Name="Usar pasta temporária padrão" Style="{StaticResource SecondaryButtonStyle}"/></Grid></Grid></Border>
                        <Grid Grid.Row="2" Margin="32,0,28,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="52"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CatalogSearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Buscar no catálogo" Style="{StaticResource SearchBoxStyle}"/>
                                <TextBlock x:Name="CatalogResultCount" Grid.Column="1" Text="0 itens" Foreground="#8D9789" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,2,0"/>
                            </Grid>
                            <Border Grid.Row="1" Visibility="{Binding Visibility, ElementName=CatalogActionStatus}" Background="#2E1510" BorderBrush="#A34B2A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,9,0,0">
                                <TextBlock x:Name="CatalogActionStatus" Text="Ação indisponível." Visibility="Collapsed" Foreground="#FFB36B" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Status da ação"/>
                            </Border>
                            <Grid Grid.Row="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-7,11,-3,0" Visibility="{Binding CatalogResultsVisibility}">
                                    <ItemsControl x:Name="CatalogItemsHost"
                                                  ItemsSource="{Binding CatalogItems}"
                                                  ItemTemplate="{StaticResource CatalogCardTemplate}"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  AutomationProperties.Name="Pacotes disponíveis">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Visibility="{Binding CatalogEmptyVisibility}" Background="#0E120E" BorderBrush="#2A3227" BorderThickness="1" CornerRadius="14" Margin="0,11,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="72" Height="72" CornerRadius="36" Background="#152010" BorderBrush="#3B512E" BorderThickness="1">
                                            <TextBlock Text="⌕" Foreground="{StaticResource LimeBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Nenhum pacote encontrado" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,16,0,5"/>
                                        <TextBlock Text="Ajuste a busca para ver outros resultados deste sistema." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding CatalogResultsVisibility}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PreviousPageButton" Content="ANTERIOR" Click="PreviousPage_Click" AutomationProperties.Name="Página anterior" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <ItemsControl x:Name="PageNumbersHost" ItemsSource="{Binding PageNumbers}" ItemTemplate="{StaticResource PageNumberTemplate}" AutomationProperties.Name="Números de página">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button x:Name="NextPageButton" Content="PRÓXIMA" Click="NextPage_Click" AutomationProperties.Name="Próxima página" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource LimeBrush}" Margin="0,0,8,0"/><TextBlock Text="MANIFESTO TURBORAMA" Foreground="#697364" FontSize="8" FontWeight="Bold"/></StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
