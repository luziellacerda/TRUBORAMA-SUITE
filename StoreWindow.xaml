<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TurboBoxManager.StoreWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TURBORAMA • RETRO SYSTEMS" Icon="Assets/turborama-app-icon.ico" Width="1380" Height="820" MinWidth="900" MinHeight="480" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#070907" Foreground="#F4F7F1" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" xmlns:turboboxmanager="clr-namespace:TurboBoxManager;assembly=Turborama" xmlns:local="clr-namespace:TurboBoxManager">
