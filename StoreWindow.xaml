      <BitmapImage x:Key="CatalogFallbackArtwork" UriSource="Assets/f15-turborama-user-original-v13.png" DecodePixelWidth="512" CacheOption="OnLoad" CreateOptions="DelayCreation" />
      <Style x:Key="TechScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Opacity" Value=".72" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Grid Margin="1" ClipToBounds="False">
                <Border x:Name="ThumbGlow"
                        CornerRadius="4"
                        BorderBrush="{StaticResource GlobalAccentBrush}"
                        BorderThickness="1"
                        Opacity=".42">
                  <Border.Effect>
                    <DropShadowEffect Color="{StaticResource GlobalAccentColor}"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity=".72" />
                  </Border.Effect>
                </Border>
                <Border x:Name="ThumbCore"
                        CornerRadius="4"
                        Background="{StaticResource GlobalAccentBrush}"
                        BorderBrush="{StaticResource GlobalBrightBrush}"
                        BorderThickness="1">
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter TargetName="ThumbGlow" Property="Opacity" Value=".88" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter TargetName="ThumbGlow" Property="Opacity" Value="1" />
                  <Setter TargetName="ThumbCore" Property="BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="#090C09" />
        <Setter Property="Foreground" Value="{StaticResource GlobalAccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Width="{TemplateBinding Width}" Background="Transparent">
                <Border Width="3"
                        HorizontalAlignment="Center"
                        Background="#172017"
                        BorderBrush="{StaticResource GlobalLineBrush}"
                        BorderThickness="1"
                        CornerRadius="2" />
                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       IsDirectionReversed="True"
                       Focusable="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="False"
                                  Opacity="0" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinHeight="34" Style="{StaticResource TechScrollThumbStyle}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="False"
                                  Opacity="0" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                  <Grid Height="{TemplateBinding Height}" Background="Transparent">
                    <Border Height="3"
                            VerticalAlignment="Center"
                            Background="#172017"
                            BorderBrush="{StaticResource GlobalLineBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    <Track x:Name="PART_Track"
                           Orientation="Horizontal"
                           IsDirectionReversed="False"
                           Focusable="False">
                      <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      Opacity="0" />
                      </Track.DecreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb MinWidth="34" Style="{StaticResource TechScrollThumbStyle}" />
                      </Track.Thumb>
                      <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      Opacity="0" />
                      </Track.IncreaseRepeatButton>
                    </Track>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="#AAB2A6" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#182016" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value=".72" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="{StaticResource GlobalContrastBrush}" />
        <Setter Property="Background" Value="{StaticResource GlobalAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Border.Background" Value="{StaticResource GlobalBrightBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource GlobalContrastBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".76" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".34" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DownloadNeonButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentSystemContrastBrush}" />
        <Setter Property="Background" Value="{DynamicResource CurrentSystemAccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Margin="2" ClipToBounds="False">
                <Border x:Name="NeonAura"
                        Margin="-1"
                        CornerRadius="10"
                        BorderBrush="{DynamicResource CurrentSystemAccentBrush}"
                        BorderThickness="1"
                        Opacity=".44"
                        IsHitTestVisible="False"
                        CacheMode="BitmapCache">
                  <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource CurrentSystemAccentColor}"
                                      BlurRadius="9"
                                      ShadowDepth="0"
                                      Opacity=".62" />
                  </Border.Effect>
                </Border>
                <Border x:Name="Surface"
                        Background="{TemplateBinding Control.Background}"
                        BorderBrush="{DynamicResource CurrentSystemBrightBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="{TemplateBinding Control.Padding}"
                        ClipToBounds="True">
                  <Grid ClipToBounds="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsVisible" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard x:Name="DownloadNeonPulse">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="NeonAura"
                                         Storyboard.TargetProperty="Opacity"
                                         From=".30" To=".72" Duration="0:0:1.15" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="DownloadNeonPulse" />
                  </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Border.Background" Value="{DynamicResource CurrentSystemBrightBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource CurrentSystemBrightContrastBrush}" />
                  <Setter TargetName="NeonAura" Property="Opacity" Value=".92" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".76" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".34" />
                  <Setter TargetName="NeonAura" Property="Visibility" Value="Collapsed" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="#EDF1EA" />
        <Setter Property="Background" Value="#171C17" />
        <Setter Property="BorderBrush" Value="#30382D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Surface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Border.BorderBrush" Value="{StaticResource GlobalAccentBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource GlobalAccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Surface" Property="UIElement.Opacity" Value=".34" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SidebarNavStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="45" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
               <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
                 <Grid>
                   <Rectangle Name="Marker" Width="3" RadiusX="2" HorizontalAlignment="Left" Opacity="0" Fill="{StaticResource LimeBrush}" />
                   <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
                   <Rectangle Height="1"
                              Margin="7,0,7,-1"
                              VerticalAlignment="Bottom"
                               Fill="{StaticResource GlobalLineBrush}"
                              Opacity=".28"
                              IsHitTestVisible="False" />
                 </Grid>
               </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Border.Background" Value="{StaticResource GlobalSelectionBrush}" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                  <Setter TargetName="Marker" Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PageNumberButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0" />
      </Style>
      <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="14" />
      </Style>
      <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="44,0,14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#E9090C09" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource GlobalAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlobalLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Frame" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
                <Grid>
                  <TextBlock Text="⌕" FontSize="22" Foreground="#768072" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <ScrollViewer Name="PART_ContentHost" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Frame" Property="Border.BorderBrush" Value="{StaticResource GlobalAccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="RetroCategoryTemplate">
        <Button Background="#00FFFFFF" BorderThickness="0" Padding="0" Margin="0,1" HorizontalContentAlignment="Stretch" Cursor="Hand" Tag="{Binding Id}" AutomationProperties.Name="{Binding DisplayName}" Click="Category_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CategorySurface" CornerRadius="8" Background="#00FFFFFF" Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="CategorySelectedTint"
                          Grid.ColumnSpan="3"
                          Margin="-8,-6"
                          CornerRadius="7"
                          Background="{DynamicResource CurrentSystemSidebarSelectionBrush}"
                          Opacity="0"
                          IsHitTestVisible="False" />
                  <Rectangle x:Name="CategoryActiveRail"
                             Grid.Column="0"
                             Width="3"
                             Height="27"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="-8,0,0,0"
                             RadiusX="2"
                             RadiusY="2"
                             Fill="{DynamicResource CurrentSystemAccentBrush}"
                             Opacity="0"
                             IsHitTestVisible="False" />
                  <Grid Width="29" Height="25">
                    <Border x:Name="CategoryIconGlow"
                            CornerRadius="7"
                            Background="{DynamicResource CurrentSystemAccentBrush}"
                            Opacity="0" />
                    <Image Source="{Binding MenuIconSource}"
                           Width="29"
                           Height="25"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <TextBlock x:Name="CategoryTitle" Grid.Column="1" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                  <TextBlock x:Name="CategoryCode"
                             Grid.Column="2"
                             Foreground="#FFFFFFFF"
                             FontSize="9"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Text="{Binding SourceItemCount}"
                             AutomationProperties.Name="{Binding CountLabel}" />
                  <Rectangle Grid.ColumnSpan="3"
                             Height="1"
                             Margin="0,0,0,-7"
                             VerticalAlignment="Bottom"
                             Fill="{DynamicResource CurrentSystemLineBrush}"
                             Opacity=".30"
                             IsHitTestVisible="False" />
                  <Rectangle x:Name="CategoryEnergyLine"
                             Grid.ColumnSpan="3"
                             Width="48"
                             Height="1"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="23,0,0,-6"
                             Fill="{DynamicResource CurrentSystemAccentBrush}"
                             Opacity="0"
                             IsHitTestVisible="False" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CategorySurface" Property="Border.Background" Value="#151C14" />
                  <Setter TargetName="CategoryIconGlow" Property="Opacity" Value=".10" />
                  <Setter TargetName="CategoryTitle" Property="TextBlock.Foreground" Value="White" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsSelected}">
                  <Setter TargetName="CategorySurface" Property="Border.Background" Value="#090C09" />
                  <Setter TargetName="CategorySelectedTint" Property="Opacity" Value="1" />
                  <Setter TargetName="CategoryActiveRail" Property="Opacity" Value="1" />
                  <Setter TargetName="CategoryIconGlow" Property="Opacity" Value=".23" />
                  <Setter TargetName="CategoryTitle" Property="TextBlock.Foreground" Value="White" />
                  <Setter TargetName="CategoryTitle" Property="TextBlock.FontWeight" Value="Bold" />
                  <Setter TargetName="CategoryCode" Property="TextBlock.Foreground" Value="{DynamicResource CurrentSystemAccentBrush}" />
                  <Setter TargetName="CategoryEnergyLine" Property="Opacity" Value=".82" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SelectedCategoryEnergy">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="CategoryActiveRail"
                                         Storyboard.TargetProperty="Opacity"
                                         From=".56" To="1" Duration="0:0:1.15" />
                        <DoubleAnimation Storyboard.TargetName="CategoryEnergyLine"
                                         Storyboard.TargetProperty="Width"
                                         From="48" To="176" Duration="0:0:1.15" />
                        <DoubleAnimation Storyboard.TargetName="CategoryEnergyLine"
                                         Storyboard.TargetProperty="Opacity"
                                         From=".30" To=".90" Duration="0:0:1.15" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SelectedCategoryEnergy" />
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="LibrarySystemCardTemplate">
        <Button Tag="{Binding CategoryId}"
                Click="LibrarySystem_Click"
                Margin="8"
                Padding="0"
                Height="214"
                Background="#00FFFFFF"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding DisplayName}">
          <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="Transparent">
                <Border x:Name="LibraryCardSurface"
                        Margin="3"
                        Background="#F5090D0B"
                        BorderThickness="0"
                        CornerRadius="11"
                        ClipToBounds="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="136" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid ClipToBounds="True" Background="#030504">
                      <Image Source="{Binding CoverThumbnail320, IsAsync=True}"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             SnapsToDevicePixels="True" />
                      <Border VerticalAlignment="Bottom" Height="32" Background="#C7000000">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Image Source="{Binding MenuIconSource}" Width="19" Height="19" Margin="0,0,7,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                          <TextBlock Text="{Binding ShortCode}" Foreground="{Binding AccentBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Grid.Column="1" Margin="18,17,15,15">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding DisplayName}"
                                 Foreground="White"
                                 FontFamily="Bahnschrift SemiCondensed"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 LineHeight="21" />
                      <Rectangle Grid.Row="1" Height="2" Width="52" HorizontalAlignment="Left" Margin="0,11,0,0" Fill="{Binding AccentBrush}" RadiusX="1" RadiusY="1" />
                      <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,4">
                        <TextBlock Text="{Binding CountLabel}" Foreground="{Binding AccentBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="JOGOS DISPONÍVEIS" Foreground="#AEB8AD" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0" />
