                      <TextBlock Text="Instale um jogo, atualize a análise ou selecione outro sistema." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <ListBox Name="ManagedGamesList"
                           ItemsSource="{Binding ManagedGames}"
                           ItemTemplate="{StaticResource ManagedGameRowTemplate}"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           VirtualizingPanel.IsVirtualizing="True"
                           VirtualizingPanel.VirtualizationMode="Recycling"
                           AutomationProperties.Name="Jogos locais do sistema">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                              <ContentPresenter />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </Grid>
                <TextBlock Name="ManagedGameManagerStatus" Grid.Row="4" Text="Selecione um sistema para analisar a pasta de ROMs." Foreground="#7F897C" FontSize="9" TextWrapping="Wrap" Margin="3,7,3,0" />
              </Grid>
            </Grid>
          </Grid>
          <Grid Name="DownloadsPage" Visibility="Collapsed" Margin="32,28,28,32" AutomationProperties.Name="Página Downloads">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="31" RadiusX="2" Fill="{StaticResource RedBrush}" Margin="0,1,12,0" />
                <StackPanel>
                  <TextBlock Text="Central de downloads" FontSize="27" FontWeight="Bold" />
                  <TextBlock Text="Retomada automática, progresso preservado e extração dos pacotes" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Content="LIMPAR CONCLUÍDOS" AutomationProperties.Name="Limpar histórico de downloads" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" IsEnabled="{Binding HasDownloads}" Click="ClearDownloadHistory_Click" />
            </Grid>
            <Grid Row="1" Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="250" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource PanelBorderStyle}" Padding="18,15">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" CornerRadius="11" Background="#182312" BorderBrush="#3A542C" BorderThickness="1">
                    <TextBlock Text="⇩" Foreground="{StaticResource LimeBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="13,1,0,0">
                    <TextBlock Text="FILA DE TRANSFERÊNCIAS" Foreground="#687363" FontSize="9" FontWeight="Bold" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0">
                      <Run Text="{Binding DownloadJobs.Count, Mode=OneWay}" />
                      <Run Text="  downloads registrados" />
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="12,0,0,0" Padding="18,15">
                <StackPanel>
                  <TextBlock Text="CONTROLE DE REDE" Foreground="#687363" FontSize="9" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource LimeBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Retomada automática ativa" FontSize="13" FontWeight="Bold" Margin="9,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Row="2" Margin="0,17,0,0">
              <Border Style="{StaticResource PanelBorderStyle}" Visibility="{Binding DownloadsEmptyVisibility}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid Width="96" Height="96">
                    <Ellipse Fill="#131B11" Stroke="#2F3C2A" StrokeThickness="1" />
                    <Path Data="M19,48 L39,68 L78,25" Stroke="{StaticResource LimeBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Grid>
                  <TextBlock Text="Nenhum download registrado" FontSize="21" FontWeight="Bold" Margin="0,19,0,7" />
                  <TextBlock Text="Escolha um pacote no catálogo para iniciar a fila." Foreground="{StaticResource MutedBrush}" />
                  <Button Content="EXPLORAR SISTEMAS" AutomationProperties.Name="Explorar sistemas" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0" Click="OpenFirstCatalog_Click" />
                </StackPanel>
              </Border>
              <ListBox Name="DownloadJobsHost" ItemTemplate="{StaticResource DownloadJobTemplate}" Background="#00FFFFFF" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Fila de downloads" ItemsSource="{Binding DownloadJobs}" Visibility="{Binding DownloadsListVisibility}">
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ListBox>
            </Grid>
          </Grid>
          <Grid Name="CatalogPage" Visibility="Collapsed" AutomationProperties.Name="Página do catálogo">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3"
                    Background="{DynamicResource CurrentSystemSurfaceBrush}"
                    IsHitTestVisible="False" />
            <Border Grid.Row="0"
                    Margin="24,15,20,10"
                    Padding="17,8"
                    Background="{DynamicResource CurrentSystemHeaderBrush}"
                    BorderBrush="{DynamicResource CurrentSystemLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="40" RadiusX="2" Fill="{DynamicResource CurrentSystemAccentBrush}" Margin="0,2,13,0">
                  <UIElement.Effect>
                    <DropShadowEffect Color="{DynamicResource CurrentSystemAccentColor}" BlurRadius="12" ShadowDepth="0" />
                  </UIElement.Effect>
                </Rectangle>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Name="CatalogPageTitle" Text="Sistemas retrô" FontSize="27" FontWeight="Bold" FontFamily="Bahnschrift SemiCondensed" />
                    <Border Background="{DynamicResource CurrentSystemPanelBrush}" BorderBrush="{DynamicResource CurrentSystemLineBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="11,3,0,0" VerticalAlignment="Top">
                      <TextBlock Name="CatalogSystemCode" Text="RETRO" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="8" FontWeight="Bold" />
                    </Border>
                  </StackPanel>
                  <TextBlock Name="CatalogPageDescription" Text="Escolha um pacote e baixe com um clique" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="▣  ABRIR PASTA" AutomationProperties.Name="Abrir pasta de instalação" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" Click="OpenInstallFolder_Click" />
                  <Button Content="●  SUPORTE" AutomationProperties.Name="Abrir suporte" Style="{StaticResource PrimaryButtonStyle}" Click="Support_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Name="CatalogFolderPanel" Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="32,0,28,17" Padding="18,14" Background="#E80B0F0C" BorderBrush="{DynamicResource CurrentSystemLineBrush}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="1" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="128" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="▣" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="19" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="PASTA DE INSTALAÇÃO" Foreground="#687263" FontSize="9" FontWeight="Bold" />
                    <TextBlock Name="InstallFolderPath" Text="Documentos\Turborama" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="ALTERAR PASTA" AutomationProperties.Name="Alterar pasta de instalação" Style="{StaticResource SecondaryButtonStyle}" Click="ChooseInstallFolder_Click" />
                </Grid>
                <Rectangle Grid.Row="1" Height="1" Fill="#252C23" Margin="0,12" />
                <Grid Row="2" Margin="0,13,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="92" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="↔" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="19" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="PASTA DOS TEMPORÁRIOS" Foreground="#687263" FontSize="9" FontWeight="Bold" />
                    <TextBlock Name="TempFolderPath" Text="(padrão do sistema)" Foreground="#D4DAD0" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="ALTERAR" AutomationProperties.Name="Alterar pasta temporária" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ChooseTempFolder_Click" />
                  <Button Grid.Column="3" Content="PADRÃO" AutomationProperties.Name="Usar pasta temporária padrão" Style="{StaticResource SecondaryButtonStyle}" Click="ResetTempFolder_Click" />
                </Grid>
              </Grid>
            </Border>
            <Border Name="RetroCatalogFolderBar" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Margin="32,0,28,8" Padding="12,8" Background="#E80B0F0C" BorderBrush="{DynamicResource CurrentSystemLineBrush}">
              <Grid Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="25" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource CurrentSystemAccentBrush}" Opacity=".9" />
                <TextBlock Text="▣" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="15" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="PASTA DE INSTALAÇÃO" Foreground="#687263" FontSize="7" FontWeight="Bold" />
                  <TextBlock FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=InstallFolderPath}" />
                </StackPanel>
                <Button Grid.Column="2" Content="ALTERAR PASTA" AutomationProperties.Name="Alterar pasta de instalação" Style="{StaticResource SecondaryButtonStyle}" Height="28" MinHeight="28" Padding="8,0" FontSize="9" Click="ChooseInstallFolder_Click" />
                <Rectangle Grid.Column="3" Width="1" Height="24" Fill="#252C23" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="↔" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="15" VerticalAlignment="Center" />
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                  <TextBlock Text="PASTA DOS TEMPORÁRIOS" Foreground="#687263" FontSize="7" FontWeight="Bold" />
                  <TextBlock Foreground="#D4DAD0" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=TempFolderPath}" />
                </StackPanel>
                <Button Grid.Column="6" Content="ALTERAR" AutomationProperties.Name="Alterar pasta temporária" Style="{StaticResource SecondaryButtonStyle}" Height="28" MinHeight="28" Padding="7,0" FontSize="9" Margin="0,0,6,0" Click="ChooseTempFolder_Click" />
                <Button Grid.Column="7" Content="PADRÃO" AutomationProperties.Name="Usar pasta temporária padrão" Style="{StaticResource SecondaryButtonStyle}" Height="28" MinHeight="28" Padding="7,0" FontSize="9" Click="ResetTempFolder_Click" />
              </Grid>
            </Border>
            <Grid x:Name="CatalogContentPanel" Row="2" Margin="32,0,28,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Name="CatalogFooterRow" Height="52" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="CatalogSearchBox" AutomationProperties.Name="Buscar no catálogo" Style="{StaticResource SearchBoxStyle}" TextChanged="Search_TextChanged" />
                <Rectangle Height="2"
                           Margin="12,0,12,0"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource CurrentSystemAccentBrush}"
                           Opacity=".42"
                           IsHitTestVisible="False" />
                <TextBlock Name="CatalogResultCount" Grid.Column="1" Text="0 itens" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,2,0" />
              </Grid>
              <Border Grid.Row="1" Background="#2E1510" BorderBrush="#A34B2A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,9,0,0" Visibility="{Binding Visibility, ElementName=CatalogActionStatus}">
                <TextBlock Name="CatalogActionStatus" Text="Ação indisponível." Visibility="Collapsed" Foreground="#FFB36B" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Status da ação" />
              </Border>
              <Grid Row="2">
                <ScrollViewer Name="CatalogGridScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-7,11,-3,0" Visibility="{Binding CatalogResultsVisibility}">
                  <ItemsControl Name="CatalogItemsHost" ItemTemplate="{StaticResource CatalogCardTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Pacotes disponíveis" ItemsSource="{Binding CatalogItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <Grid x:Name="RetroCarouselHost"
                      Visibility="Collapsed"
                      Margin="-22,4,-22,0"
                      ClipToBounds="True"
                      Focusable="True"
                      PreviewMouseWheel="RetroCarousel_PreviewMouseWheel"
                      AutomationProperties.Name="Carrossel de sistemas retrô">
                  <Grid x:Name="RetroSystemVideoBackground"
                        Background="#070A07"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        Panel.ZIndex="0">
                    <Grid x:Name="RetroUniversalVideoPlayerHost"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="False"
                          Panel.ZIndex="0" />
                    <Grid x:Name="RetroSystemVideoPlayerHost"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="False"
                          Panel.ZIndex="1" />
                    <Border Background="{DynamicResource CurrentSystemVideoOverlayBrush}"
                            Panel.ZIndex="2" />
                  </Grid>
                  <Viewbox x:Name="RetroCarouselScaleHost"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           Panel.ZIndex="10">
                    <Grid x:Name="RetroCarouselViewport"
                          Width="1060"
                          Height="398"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ClipToBounds="True">
                    <Grid x:Name="RetroCarouselInfoPanel"
                          Width="740"
                          Height="160"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,8"
                          IsHitTestVisible="False"
                          Panel.ZIndex="2">
                      <Rectangle
                                 Width="2"
                                 Height="118"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource CurrentSystemAccentBrush}"
                                 Opacity=".72" />
                      <Grid Margin="17,0,4,0">
                        <StackPanel HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                          <TextBlock Name="RetroCarouselTitle"
                                     Text="Sistema retrô"
                                     Foreground="White"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     FontFamily="Bahnschrift SemiCondensed"
                                     TextOptions.TextRenderingMode="ClearType"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Name="RetroCarouselPackageType"
                                     Text="Jogos retrô • Catálogo completo"
                                     Foreground="{DynamicResource CurrentSystemAccentBrush}"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"
                                     TextTrimming="CharacterEllipsis" />
                           <TextBlock Name="RetroCarouselPackageDescription"
                                     Text="Coleção Turborama • Tamanho sob consulta"
                                     Foreground="#F2F6F0"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     LineHeight="17"
                                     Margin="0,7,0,0"
                                     TextWrapping="Wrap"
                                     TextOptions.TextRenderingMode="ClearType"
                                     TextTrimming="None" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                    <Canvas x:Name="RetroCarouselTrack" Width="1060" Height="398" Panel.ZIndex="10">
                      <ContentControl x:Name="RetroCarouselCurrent"
                                      Canvas.Left="30"
                                      Canvas.Top="0"
                                      Width="250"
                                      Height="375"
                                      Opacity="1"
                                      Panel.ZIndex="40"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <ContentControl x:Name="RetroCarouselMini1"
                                      Canvas.Left="320"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity=".95"
                                      Panel.ZIndex="25"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <ContentControl x:Name="RetroCarouselMini2"
                                      Canvas.Left="470"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity=".90"
                                      Panel.ZIndex="24"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <ContentControl x:Name="RetroCarouselMini3"
                                      Canvas.Left="620"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity=".85"
                                      Panel.ZIndex="23"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <ContentControl x:Name="RetroCarouselMini4"
                                      Canvas.Left="770"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity=".80"
                                      Panel.ZIndex="22"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <ContentControl x:Name="RetroCarouselMini5"
                                      Canvas.Left="920"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity=".75"
                                      Panel.ZIndex="21"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                      <!-- This recycled control is rebound only while fully outside the viewport. -->
                      <ContentControl x:Name="RetroCarouselIncoming"
                                      Canvas.Left="1070"
                                      Canvas.Top="0"
                                      Width="140"
                                      Height="210"
                                      Opacity="0"
                                      IsEnabled="False"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      KeyboardNavigation.IsTabStop="False"
                                      Panel.ZIndex="20"
                                      ContentTemplate="{StaticResource RetroCarouselPosterTemplate}" />
                    </Canvas>

                    <ContentControl x:Name="RetroCarouselActionBar"
                                    Width="250"
                                    Height="20"
                                    Focusable="False"
                                    KeyboardNavigation.IsTabStop="False"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="30,0,0,0"
                                    Panel.ZIndex="60"
                                    ContentTemplate="{StaticResource RetroCarouselActionTemplate}" />

                    </Grid>
                  </Viewbox>
                </Grid>
                <Border Background="#0E120E" BorderBrush="#2A3227" BorderThickness="1" CornerRadius="14" Margin="0,11,0,0" Visibility="{Binding CatalogEmptyVisibility}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#152010" BorderBrush="#3B512E" BorderThickness="1">
                      <TextBlock Text="⌕" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nenhum pacote encontrado" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" Margin="0,16,0,5" />
                    <TextBlock Text="Ajuste a busca para ver outros resultados deste sistema." Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Row="3" Margin="0,5,0,0" Visibility="{Binding CatalogResultsVisibility}">
                <StackPanel Name="CatalogPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Name="PreviousPageButton" Content="ANTERIOR" AutomationProperties.Name="Página anterior" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="PreviousPage_Click" />
                  <ItemsControl Name="PageNumbersHost" ItemTemplate="{StaticResource PageNumberTemplate}" AutomationProperties.Name="Números de página" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Button Name="NextPageButton" Content="PRÓXIMA" AutomationProperties.Name="Próxima página" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="NextPage_Click" />
                </StackPanel>
                <Border Name="RetroCarouselFooter"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="960"
                        Background="#DC080B08"
                        BorderThickness="0"
                        CornerRadius="5"
                        Padding="14,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource CurrentSystemAccentBrush}" Opacity=".72" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="← →  NAVEGAR" Foreground="#DDE6D9" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="   •   RODA DO MOUSE  ALTERNAR" Foreground="#A9B3A5" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="   •   ENTER  SELECIONAR" Foreground="#A9B3A5" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="   •   " Foreground="#596354" FontSize="9" VerticalAlignment="Center" />
                      <TextBlock Name="RetroCarouselPosition" Text="1 / 45" Foreground="{DynamicResource CurrentSystemAccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Name="CatalogManifestPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource CurrentSystemAccentBrush}" Margin="0,0,8,0" />
                  <TextBlock Text="MANIFESTO TURBORAMA" Foreground="#697364" FontSize="8" FontWeight="Bold" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
