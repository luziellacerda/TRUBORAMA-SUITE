        <Border Margin="0,0,0,8"
                Padding="10"
                MinHeight="104"
                Background="#E90A0E0B"
                BorderBrush="#2D372B"
                BorderThickness="1"
                CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="78" CornerRadius="6" ClipToBounds="True" Background="#050705" BorderBrush="#34402E" BorderThickness="1">
              <Image Source="{Binding Thumbnail160, IsAsync=True}"
                     Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="{Binding ImageAltText}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,2,12,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="9" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding StatusDetail}" Foreground="#707A6D" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LocalPath}"
                         ToolTip="{Binding LocalPath}"
                         AutomationProperties.Name="{Binding LocalPath}"
                         Foreground="#596356"
                         FontSize="8"
                         Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
