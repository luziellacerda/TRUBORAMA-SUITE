                    VerticalAlignment="Center"
                    IsEnabled="{Binding CanDelete}"
                    Click="DeleteManagedGame_Click" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="CatalogCardTemplate">
        <Grid AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding DownloadStatus}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Grid}">
              <Setter Property="Height" Value="238" />
              <Setter Property="Margin" Value="8,7,8,11" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Style.Triggers>
                <DataTrigger Value="retro-games" Binding="{Binding CategoryId}">
                  <Setter Property="Width" Value="171" />
                  <Setter Property="Height" Value="313" />
                  <Setter Property="Margin" Value="8,3" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                </DataTrigger>
                <DataTrigger Value="system-tools" Binding="{Binding CategoryId}">
                  <Setter Property="Height" Value="192" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <Border Name="CardGlowSurface" Margin="0" Background="#111511" BorderBrush="#00FFFFFF" BorderThickness="0" CornerRadius="15" IsHitTestVisible="False">
            <UIElement.Effect>
              <DropShadowEffect x:Name="CardGlow" Color="#9DFF00" BlurRadius="12" ShadowDepth="0" Opacity="0" />
            </UIElement.Effect>
          </Border>
          <Border Name="CardShell" Background="#0B0E0B" BorderBrush="#00FFFFFF" BorderThickness="0" CornerRadius="14" ClipToBounds="True" Cursor="Hand">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
              </Grid.RowDefinitions>
              <Grid Name="CardCoverFrame" ClipToBounds="True" Background="#050705">
                <Image Name="CardCoverFallback" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" IsHitTestVisible="False" Source="{StaticResource CatalogFallbackArtwork}" />
                <Image Name="CardCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" AutomationProperties.HelpText="Capa específica deste item" Source="{Binding Thumbnail384, IsAsync=True}" AutomationProperties.Name="{Binding ImageAltText}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Image}">
                      <Setter Property="UIElement.Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Value="" Binding="{Binding ImageSource}">
                          <Setter Property="UIElement.Opacity" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                          <Setter Property="UIElement.Opacity" Value="0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Image>
                <Border Name="CardCoverLoading" Background="#E0080B08">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="" Binding="{Binding ImageSource}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding SystemGlyph}" Foreground="{Binding AccentBrush}" />
                    <TextBlock Text="CAPA TURBORAMA" Foreground="#BEC7BA" FontSize="8" FontWeight="Bold" Margin="0,9,0,0" />
                  </StackPanel>
                </Border>
                <Grid Name="CardBusyOverlay" Height="34" VerticalAlignment="Bottom" IsHitTestVisible="False">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Grid}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsBusy}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Border Background="#BC060906" />
                  <TextBlock Name="CardDownloadStatus" Foreground="#FFFFFFFF" FontSize="9" FontWeight="SemiBold" Margin="9,0,9,4" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DownloadStatus}" />
                  <ProgressBar Name="CardDownloadProgress" Minimum="0" Maximum="100" Background="#00FFFFFF" BorderThickness="0" Height="3" VerticalAlignment="Bottom" Value="{Binding ProgressPercentage, Mode=OneWay}" Foreground="{Binding AccentBrush}" />
                </Grid>
              </Grid>
              <Grid Row="1" Margin="8,7">
                <Button Name="CardDownloadButton" Content="{Binding DownloadActionLabel}" IsEnabled="{Binding CanDownload}" Tag="{Binding Id}" AutomationProperties.Name="{Binding DownloadActionLabel}" AutomationProperties.HelpText="{Binding Title}" Click="DownloadItem_Click">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DownloadNeonButtonStyle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding CanPause}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Value="True" Binding="{Binding CanOpen}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
                <Button Name="CardCancelButton" Content="PAUSAR DOWNLOAD" AutomationProperties.Name="Pausar download sem apagar o progresso" Foreground="#FFD36B" BorderBrush="#806423" Tag="{Binding Id}" AutomationProperties.HelpText="{Binding Title}" Click="DownloadItem_Click">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding CanPause}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
                <Button Name="CardOpenButton" Content="ABRIR PASTA  ✓" AutomationProperties.Name="Abrir pasta do pacote" Tag="{Binding Id}" AutomationProperties.HelpText="{Binding Title}" Click="DownloadItem_Click">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding CanOpen}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <DataTemplate.Triggers>
          <EventTrigger RoutedEvent="MouseEnter" SourceName="CardShell">
            <BeginStoryboard Name="CardHoverPulse">
              <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" From=".28" To=".82" Duration="0:0:.75" />
                <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" From="14" To="28" Duration="0:0:.75" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave" SourceName="CardShell">
            <StopStoryboard BeginStoryboardName="CardHoverPulse" />
          </EventTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <!-- One elastic poster template is shared by all eight recycled carousel controls. -->
      <DataTemplate x:Key="RetroCarouselPosterTemplate">
        <Button Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Tag="{Binding}"
                AutomationProperties.Name="{Binding Title}"
                Click="RetroCarouselItem_Click">
          <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Border x:Name="PosterGlowAura"
                        Margin="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CurrentSystemAccentBrush}"
                        BorderThickness="5"
                        CornerRadius="5"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <Border x:Name="PosterGlow"
                        Margin="2"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CurrentSystemAccentBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <Rectangle x:Name="PosterOrbitLine"
                           Margin="1"
                           RadiusX="5"
                           RadiusY="5"
                           Fill="Transparent"
                           Stroke="{DynamicResource CurrentSystemAccentBrush}"
                           StrokeThickness="2.5"
                           StrokeDashArray="44 900"
                           StrokeDashCap="Square"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Panel.ZIndex="4">
                  <Rectangle.Effect>
                    <DropShadowEffect Color="{DynamicResource CurrentSystemAccentColor}"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity=".9" />
                  </Rectangle.Effect>
                </Rectangle>
                <Grid x:Name="PosterArtwork" ClipToBounds="True" Background="#050705">
                  <Image Source="{StaticResource CatalogFallbackArtwork}"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         SnapsToDevicePixels="True"
                         IsHitTestVisible="False">
                    <Image.Style>
                      <Style TargetType="{x:Type Image}">
                        <Setter Property="Stretch" Value="UniformToFill" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CategoryId}" Value="retro-games">
                            <Setter Property="Stretch" Value="UniformToFill" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                  <Image Source="{Binding Thumbnail384, IsAsync=True}"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         SnapsToDevicePixels="True"
                         AutomationProperties.Name="{Binding ImageAltText}">
                    <Image.Style>
                      <Style TargetType="{x:Type Image}">
                        <Setter Property="Stretch" Value="UniformToFill" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CategoryId}" Value="retro-games">
                            <Setter Property="Stretch" Value="UniformToFill" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                  <Grid Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Grid.Style>
                      <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Border Background="#D0060906" />
                    <TextBlock Text="{Binding DownloadStatus}"
                               Foreground="White"
                               FontSize="8"
                               FontWeight="SemiBold"
                               Margin="5,0,5,4"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 Foreground="{Binding AccentBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="3"
                                 VerticalAlignment="Bottom" />
                  </Grid>
                  <Border x:Name="PosterHoverTint" Background="Transparent" IsHitTestVisible="False" />
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="PosterHoverTint" Property="Background" Value="#12FFFFFF" />
                  <Setter TargetName="PosterGlow" Property="Opacity" Value=".88" />
                  <Setter TargetName="PosterGlowAura" Property="Opacity" Value=".20" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="PosterHoverTint" Property="Background" Value="#26000000" />
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=Tag}" Value="0">
                  <Setter TargetName="PosterGlow" Property="Opacity" Value=".48" />
                  <Setter TargetName="PosterGlowAura" Property="Opacity" Value=".12" />
                  <Setter TargetName="PosterOrbitLine" Property="Opacity" Value="1" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SelectedPosterPulse">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="PosterGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From=".30" To=".66" Duration="0:0:1.45" />
                        <DoubleAnimation Storyboard.TargetName="PosterGlowAura"
                                         Storyboard.TargetProperty="Opacity"
                                         From=".06" To=".22" Duration="0:0:1.45" />
                      </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard x:Name="SelectedPosterOrbit">
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="PosterOrbitLine"
                                         Storyboard.TargetProperty="StrokeDashOffset"
                                         From="0" To="-944" Duration="0:0:1.55" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SelectedPosterPulse" />
                    <RemoveStoryboard BeginStoryboardName="SelectedPosterOrbit" />
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DataTemplate>

      <!-- Download/pause/open remains fixed below the selected poster while covers move. -->
      <DataTemplate x:Key="RetroCarouselActionTemplate">
        <Grid Width="250" Height="20" AutomationProperties.HelpText="{Binding DownloadStatus}">
          <Button Content="{Binding DownloadActionLabel}"
                  IsEnabled="{Binding CanDownload}"
                  Tag="{Binding Id}"
                  Click="DownloadItem_Click"
                  AutomationProperties.Name="{Binding DownloadActionLabel}"
                  AutomationProperties.HelpText="{Binding Title}">
            <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DownloadNeonButtonStyle}">
                <Setter Property="Height" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanPause}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  <DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="PAUSAR"
                  Tag="{Binding Id}"
                  Click="DownloadItem_Click"
                  AutomationProperties.Name="Pausar download sem apagar o progresso"
                  AutomationProperties.HelpText="{Binding Title}">
            <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Foreground" Value="#FFD36B" />
                <Setter Property="BorderBrush" Value="#806423" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanPause}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="ABRIR PASTA  ✓"
                  Tag="{Binding Id}"
                  Click="DownloadItem_Click"
                  AutomationProperties.Name="Abrir pasta do pacote"
                  AutomationProperties.HelpText="{Binding Title}">
            <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Height" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DownloadJobTemplate">
        <Border Background="#101510" BorderBrush="#293228" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="15,13">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="78" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Border Width="68"
                    Height="102"
                    CornerRadius="8"
                    Background="#070A07"
                    BorderBrush="{Binding Item.AccentBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    AutomationProperties.Name="{Binding Item.ImageAltText}">
              <Grid>
                <TextBlock Text="⇩"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{Binding Item.AccentBrush}"
                           Opacity=".42" />
                <Image Source="{Binding Item.Thumbnail160, IsAsync=True}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       AutomationProperties.Name="{Binding Item.ImageAltText}" />
              </Grid>
            </Border>
            <Grid Column="1" Margin="12,0,18,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <Border DockPanel.Dock="Right" Background="#192219" CornerRadius="4" Padding="7,3" Margin="10,0,0,0">
                  <TextBlock FontSize="8" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" Text="{Binding StateLabel}" />
                </Border>
              </DockPanel>
              <TextBlock Grid.Row="1" Foreground="#727D6F" FontSize="9" Margin="0,3,0,0" Text="{Binding Category}" />
              <TextBlock Grid.Row="2" Foreground="#AAB4A6" FontSize="10" Margin="0,5,0,5" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
              <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Background="#232B20" BorderThickness="0" Height="4" Foreground="{StaticResource LimeBrush}" Value="{Binding ProgressPercentage, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button Name="DownloadJobPauseButton" Content="PAUSAR" AutomationProperties.Name="Pausar download sem apagar o progresso" Tag="{Binding}" AutomationProperties.HelpText="{Binding Title}" Click="PauseDownloadJob_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding CanPause}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Name="DownloadJobResumeButton" Content="CONTINUAR" AutomationProperties.Name="Continuar download preservado" Tag="{Binding}" AutomationProperties.HelpText="{Binding Title}" Click="ResumeDownloadJob_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding CanResume}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Name="DownloadJobExtractButton" Content="TENTAR EXTRAÇÃO" AutomationProperties.Name="Tentar extração novamente" Margin="0,6,0,0" Tag="{Binding}" AutomationProperties.HelpText="{Binding Title}" Click="RetryExtractionJob_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding CanRetryExtraction}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Name="DownloadJobOpenButton" Content="ABRIR PASTA  ✓" AutomationProperties.Name="Abrir pasta do download" Tag="{Binding}" AutomationProperties.HelpText="{Binding Title}" Click="OpenDownloadJob_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding CanOpen}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Name="DownloadJobDiscardButton" Content="APAGAR PACOTE" AutomationProperties.Name="Cancelar definitivamente e apagar o pacote" Foreground="#FF7180" BorderBrush="#7A2932" Margin="0,6,0,0" Tag="{Binding}" AutomationProperties.HelpText="{Binding Title}" Click="DiscardDownloadJob_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding CanDiscard}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </StackPanel>
