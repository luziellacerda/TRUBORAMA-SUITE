<Application x:Class="Turborama.UiPreview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PreviewAccent" Color="#F6A800" />
        <SolidColorBrush x:Key="PreviewPanel" Color="#151A16" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#090B09" />
            <Setter Property="Background" Value="{StaticResource PreviewAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6ECE4" />
            <Setter Property="Background" Value="#151A16" />
            <Setter Property="BorderBrush" Value="#3B463B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
