<Window x:Class="Turborama.UiPreview.PreviewCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Turborama.UiPreview"
        Title="Turborama — Prévia local somente leitura"
        Width="1420"
        Height="880"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#070A07"
        Foreground="#F3F6F1"
        FontFamily="Segoe UI"
        Icon="Assets/turborama-app-icon.ico">
    <Window.Resources>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#BCC6BA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#253421" />
                                <Setter Property="Foreground" Value="#F6A800" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#1B241A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111611" />
            <Setter Property="BorderBrush" Value="#303A30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F6A800" />
                                <Setter TargetName="CardBorder" Property="Background" Value="#172016" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F6A800" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#C8441717" BorderBrush="#FF6B58" BorderThickness="0,0,0,1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFF2EF" FontSize="12" FontWeight="Bold"
                       Text="PRÉVIA LOCAL • SOMENTE VISUALIZAÇÃO • NÃO É LICENÇA • NÃO DISTRIBUIR" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#0E120E" BorderBrush="#2A342A" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="Assets/turborama-logo-v3.png" Height="58" Stretch="Uniform" HorizontalAlignment="Left" />
                    <Border Grid.Row="1" Margin="0,16,0,8" Padding="10" Background="#192218" CornerRadius="8" BorderBrush="#3A4938" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="VISUALIZADOR LOCAL" Foreground="#9DFF00" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Nenhuma autorização do servidor" Margin="0,4,0,0" Foreground="#8F9A8D" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="SISTEMAS" Margin="2,10,0,7" Foreground="#657064" FontSize="10" FontWeight="Bold" />
                    <ListBox x:Name="CategoryList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CategoryItemStyle}" SelectionChanged="CategoryList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconPath}" Width="19" Height="19" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Items.Count}" Foreground="#687267" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock x:Name="ExpiryText" Foreground="#788376" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="#505A50" FontSize="9" Text="Conteúdo local, sem downloads ou instalação." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,6,24,6" VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryCodeText" Foreground="#F6A800" FontWeight="Bold" FontSize="12" />
                        <TextBlock x:Name="CategoryTitleText" Margin="0,5,0,0" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="CategoryDescriptionText" Margin="0,8,0,0" Foreground="#A5AFA3" FontSize="14" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                        <Border Margin="0,16,0,0" Padding="12,8" Background="#131913" BorderBrush="#2D382D" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SelectedItemTitleText" Foreground="#E9EEE7" FontWeight="SemiBold" />
                                <TextBlock Text="  •  somente leitura" Foreground="#6F7A6D" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SelectedItemDescriptionText" Margin="0,10,0,0" Foreground="#7E897C" FontSize="12" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <local:SquareMediaHost Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxHeight="270" Margin="8">
                        <Border Background="#0C100C" BorderBrush="#475347" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <MediaElement x:Name="PreviewVideo" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              ScrubbingEnabled="False" IsMuted="True" MediaEnded="PreviewVideo_MediaEnded" MediaFailed="PreviewVideo_MediaFailed" />
                                <Grid x:Name="MediaPlaceholder" Background="#121812">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="◫" Foreground="#F6A800" FontSize="42" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="MediaStatusText" Margin="10,8" Text="VÍDEO LOCAL" Foreground="#7F8B7D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border VerticalAlignment="Bottom" Background="#B2070A07" Padding="10,7">
                                    <TextBlock Text="QUADRADO RESPONSIVO • UNIFORM TO FILL" Foreground="#D5DDD2" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </local:SquareMediaHost>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#101510" BorderBrush="#354035" BorderThickness="1" CornerRadius="9" Padding="12,7" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" Foreground="#818C7F" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBox x:Name="SearchInput" Grid.Column="1" Width="390" Background="Transparent" BorderThickness="0" Foreground="#F2F5F0"
                                     CaretBrush="#F6A800" FontSize="14" VerticalContentAlignment="Center" TextChanged="SearchInput_TextChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="12,8" Background="#211C0C" BorderBrush="#705A15" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="AÇÕES DO SERVIDOR INDISPONÍVEIS" Foreground="#D8B640" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CardsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButtonStyle}" Tag="{Binding Item}" Click="Card_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="170" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        <Border Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="7" Padding="7,3" Background="#D30B0E0B" CornerRadius="5">
                                            <TextBlock Text="{Binding Badge}" Foreground="#F6A800" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="11,9,11,11">
                                            <TextBlock Text="{Binding Title}" Foreground="#F1F4EF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0" Foreground="#748073" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="6,10,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Style="{StaticResource GhostButton}" Content="← ANTERIOR" Click="PreviousButton_Click" />
                    <TextBlock x:Name="PageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7D887B" FontSize="11" />
                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="PRÓXIMA →" Click="NextButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
