<Window x:Class="Turborama.UiPreview.PreviewLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turborama UI Preview"
        Width="560"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#080B08"
        Foreground="#F4F7F1"
        FontFamily="Segoe UI"
        Icon="Assets/turborama-app-icon.ico">
    <Border Margin="18" Background="{StaticResource PreviewPanel}" BorderBrush="#4D5C4D" BorderThickness="1" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/turborama-logo-v3.png" Width="220" Height="54" Stretch="Uniform" HorizontalAlignment="Left" />
                <Border Margin="18,4,0,4" Padding="10,5" Background="#332300" BorderBrush="{StaticResource PreviewAccent}" BorderThickness="1" CornerRadius="6">
                    <TextBlock Text="PRÉVIA LOCAL" Foreground="{StaticResource PreviewAccent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,24,0,0" Text="Visualização administrativa temporária" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#A7B0A7" TextWrapping="Wrap"
                       Text="Esta ferramenta permite navegar pelas telas, capas e vídeos locais. Downloads, instalação, extração e alterações de pasta permanecem bloqueados." />

            <StackPanel Grid.Row="3" Margin="0,24,0,0">
                <TextBlock Text="SENHA DE VISUALIZAÇÃO LOCAL" Foreground="#A7B0A7" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                <Border Background="#090C09" BorderBrush="#4A5449" BorderThickness="1" CornerRadius="8" Padding="12,4">
                    <PasswordBox x:Name="PasswordInput" MaxLength="128" Background="Transparent" BorderThickness="0" Foreground="White"
                                 FontSize="16" PasswordChar="●" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#FF7E89" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="EnterButton" Grid.Column="1" MinWidth="126" Content="ABRIR PRÉVIA" Click="Enter_Click"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>

            <TextBlock Grid.Row="5" Margin="0,22,0,0" Foreground="#667066" FontSize="10" TextWrapping="Wrap"
                       Text="NÃO DISTRIBUIR • NÃO É UMA LICENÇA • O TURBORAMA.EXE DE PRODUÇÃO CONTINUA EXIGINDO AUTORIZAÇÃO DO SERVIDOR" />
        </Grid>
    </Border>
</Window>
