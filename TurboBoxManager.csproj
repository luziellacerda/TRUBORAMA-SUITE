<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Turborama</AssemblyName>
    <RootNamespace>TurboBoxManager</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>Turborama</Product>
    <Company>Turborama</Company>
    <Description>Central Turborama de sistemas, biblioteca e downloads.</Description>
    <ApplicationIcon>Assets\turborama-app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <CheckForOverflowUnderflow Condition="'$(Configuration)' == 'Release'">true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CatalogVerifier" />
  </ItemGroup>
  <ItemGroup Condition="'$(SuiteAuthorityConfigurationBase64)' != '' and '$(SuiteAuthorityConfigurationSha256)' != '' and '$(SuiteAuthorityIssuerSpkiBase64)' != ''">
    <AssemblyMetadata Include="TurboRama.Suite.AuthorityConfigurationBase64"
                      Value="$(SuiteAuthorityConfigurationBase64)" />
    <AssemblyMetadata Include="TurboRama.Suite.AuthorityConfigurationSha256"
                      Value="$(SuiteAuthorityConfigurationSha256)" />
    <AssemblyMetadata Include="TurboRama.Suite.AuthorityIssuerSpkiBase64"
                      Value="$(SuiteAuthorityIssuerSpkiBase64)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="obj-*\**\*.cs" />
    <Page Remove="tools\**\*.xaml;tests\**\*.xaml;obj-*\**\*.xaml" />
    <ApplicationDefinition Remove="tools\**\App.xaml;tests\**\App.xaml;obj-*\**\App.xaml" />
    <Resource Remove="tools\UiPreview\**\*" />
    <Content Remove="tools\UiPreview\**\*;tools\UiPreview.Tests\**\*" />
    <None Remove="tools\UiPreview\**\*;tools\UiPreview.Tests\**\*" />
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\Catalog\catalog.json;Assets\Catalog\Images\*.jpg;Assets\Catalog\MenuIcons\*.png;Assets\Catalog\SystemIcons\*.png;Assets\Catalog\GameDescriptions\*.xml;Assets\Catalog\SystemVideos\*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\BackgroundVideos\*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Resource Include="Assets\f15-turborama-user-original-v13.png" />
    <Resource Include="Assets\turborama-logo-v3.png" />
    <Resource Include="Assets\turborama-app-icon.ico" />
    <EmbeddedResource Include="Assets\Catalog\platform-descriptions.json"
                      LogicalName="Turborama.PlatformDescriptions.json" />
    <EmbeddedResource Include="Assets\Catalog\SystemVideos\system-videos.json"
                      LogicalName="Turborama.SystemVideos.json" />
    <EmbeddedResource Include="Assets\Catalog\SystemVideos\system-video-integrity.json"
                      LogicalName="Turborama.SystemVideoIntegrity.json" />
    <EmbeddedResource Include="Assets\BackgroundVideos\background-video-integrity.json"
                      LogicalName="Turborama.BackgroundVideoIntegrity.json" />
  </ItemGroup>
</Project>
