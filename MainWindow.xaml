<Window x:Class="TurboBoxManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TURBORAMA" Icon="Assets/turborama-app-icon.ico"
 Width="1366" Height="768" MinWidth="1050" MinHeight="650"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#090A0D" Foreground="White">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#78D800"/><Setter Property="Foreground" Value="#071000"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="18,12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111317"/><Setter Property="BorderBrush" Value="#292D34"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="LoginView" Background="#07090D">
   <Ellipse Width="850" Height="850" Fill="#0C1308" Opacity=".78"/><TextBlock Text="TR" FontSize="360" FontWeight="Black" Foreground="#131B0E" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".9"/>
   <Border Width="440" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24" BorderBrush="#8BEB14" BorderThickness="2" Background="#121510">
    <Border.Effect><DropShadowEffect Color="#7FE600" BlurRadius="42" ShadowDepth="0" Opacity=".48"/></Border.Effect>
    <StackPanel><Border Width="88" Height="68" CornerRadius="16" Background="#17220D" BorderBrush="#8BEB14" BorderThickness="1" HorizontalAlignment="Center"><TextBlock Text="TR" FontSize="34" FontWeight="Black" Foreground="#9DFF00" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="L Z   G A M E S" HorizontalAlignment="Center" Margin="0,22,0,0" FontWeight="Bold" Foreground="#9DFF00"/><TextBlock Text="Bem-vindo" HorizontalAlignment="Center" Margin="0,17,0,0" FontSize="28" FontWeight="Bold"/><TextBlock Text="Insira sua licença para continuar" HorizontalAlignment="Center" Margin="0,8,0,22" Foreground="#A8ACB5"/>
     <TextBox x:Name="LicenseBox" Height="48" Padding="15,13" Background="#111214" BorderBrush="#3A3D43" BorderThickness="2" Foreground="White" FontWeight="SemiBold" TextAlignment="Center"/><Button Content="ATIVAR LICENÇA" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Activate_Click"/>
     <TextBlock HorizontalAlignment="Center" Margin="0,22,0,0" Foreground="#A8ACB5"><Run Text="Ainda não possui licença? "/><Run Text="Conheça os planos" Foreground="#9DFF00"/></TextBlock>
    </StackPanel>
   </Border>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0"><Button Content="—" Width="42" HorizontalContentAlignment="Center" Click="Minimize_Click"/><Button Content="×" Width="42" HorizontalContentAlignment="Center" FontSize="20" Click="Close_Click"/></StackPanel>
  </Grid>

  <Grid x:Name="ShellView" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#080A07" BorderBrush="#26301E" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="TR" FontWeight="Black" Foreground="#9DFF00" Margin="0,0,12,0"/><TextBlock Text="TURBORAMA" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↓" Width="42" HorizontalContentAlignment="Center"/><Button Content="—" Width="42" HorizontalContentAlignment="Center" Click="Minimize_Click"/><Button Content="□" Width="42" HorizontalContentAlignment="Center" Click="Maximize_Click"/><Button Content="×" Width="42" HorizontalContentAlignment="Center" FontSize="18" Click="Close_Click"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0B0E09" BorderBrush="#26301E" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="TR" FontSize="50" FontWeight="Black" Foreground="#9DFF00" HorizontalAlignment="Center" Margin="0,34,0,8"/><TextBlock Text="TURBORAMA • Versão 1.5.0" Foreground="#6D7C60" HorizontalAlignment="Center" Margin="0,0,0,22"/><Separator Background="#26301E" Margin="23,0,23,16"/>
     <Button Content="▌  Home" Tag="Home" Style="{StaticResource NavButton}" Background="#15191F" Click="Navigate_Click"/><Button Content="     Conta" Tag="Conta" Style="{StaticResource NavButton}" Click="Navigate_Click"/><Button Content="     Novidades" Tag="Novidades" Style="{StaticResource NavButton}" Click="Navigate_Click"/><Button Content="     Tutoriais" Tag="Tutoriais" Style="{StaticResource NavButton}" Click="Navigate_Click"/><Button Content="▣  Catálogo" Tag="Catalogo" Style="{StaticResource NavButton}" FontWeight="SemiBold" Click="Navigate_Click"/>
     <TextBlock Text="•  Aplicativos e utilitários" Margin="39,10,0,8" Foreground="#9CA4B3"/><TextBlock Text="•  Emuladores autorizados" Margin="39,10,0,8" Foreground="#9CA4B3"/><TextBlock Text="•  Jogos gratuitos" Margin="39,10,0,8" Foreground="#9CA4B3"/><TextBlock Text="•  Meus arquivos" Margin="39,10,0,8" Foreground="#9CA4B3"/><Button Content="⇩  Downloads" Tag="Downloads" Style="{StaticResource NavButton}" Click="Navigate_Click"/>
    </StackPanel><Border DockPanel.Dock="Bottom" Background="#12161C" Padding="14" Margin="12" CornerRadius="10"><StackPanel><TextBlock Text="LICENÇA ATIVA" Foreground="#36D278" FontWeight="Bold"/><TextBlock Text="Plano de demonstração" Foreground="#8992A3" Margin="0,4,0,0"/></StackPanel></Border></DockPanel></Border>
    <Grid Grid.Column="1" Background="#090A0C">
     <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><Grid Margin="42,20,32,34"><Grid.ColumnDefinitions><ColumnDefinition Width="36*"/><ColumnDefinition Width="64*"/></Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" Height="135" VerticalAlignment="Top" Style="{StaticResource Card}" Background="#10190B" BorderBrush="#4D7D21"><Grid Margin="25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="CENTRAL TURBORAMA" FontSize="13" Foreground="#9DFF00" FontWeight="Bold"/><TextBlock Text="Sua biblioteca, organizada." FontSize="27" FontWeight="Bold" Margin="0,8,0,5"/><TextBlock Text="Gerencie seus conteúdos licenciados e gratuitos em um único lugar." Foreground="#AAB2BE"/></StackPanel><Border Grid.Column="1" Background="#1B2B10" CornerRadius="70" Width="100" Height="100"><TextBlock Text="TR" FontSize="40" FontWeight="Black" Foreground="#9DFF00" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
      <Border Grid.Column="0" Margin="0,155,14,0" Style="{StaticResource Card}" BorderBrush="#588E22"><StackPanel Margin="24"><TextBlock Text="ÚLTIMA NOTÍCIA" Foreground="#9DFF00" FontWeight="Bold" HorizontalAlignment="Center"/><Border Height="190" Background="#17220F" CornerRadius="9" Margin="0,18"><TextBlock Text="ATUALIZAÇÕES&#10;TURBORAMA" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#A8FF3C"/></Border><TextBlock Text="Novidades da plataforma" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Acompanhe correções e novos recursos." Foreground="#B3BBC7" HorizontalAlignment="Center" Margin="0,10,0,20"/><Button Content="LER NOTÍCIA" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
      <StackPanel Grid.Column="1" Margin="0,155,0,0"><Border Style="{StaticResource Card}" BorderBrush="#C02B35" Background="#180D10" Padding="20"><DockPanel><Button DockPanel.Dock="Right" Content="VER PLANOS" Background="#8D111C" HorizontalContentAlignment="Center" Padding="24,10"/><TextBlock Text="!" FontSize="30" Foreground="#FF3546" FontWeight="Bold" Margin="0,0,16,0"/><StackPanel><TextBlock Text="AVISO IMPORTANTE" Foreground="#FF4050" FontSize="20" FontWeight="Bold"/><TextBlock Text="Conecte o servidor para receber atualizações e suporte." Foreground="#D4D7DD" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource Card}" BorderBrush="#588E22" Margin="0,20,0,0" Padding="22"><StackPanel><TextBlock Text="ÚLTIMOS ITENS ADICIONADOS" Foreground="#9DFF00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/><UniformGrid Columns="3"><Border Background="#172012" CornerRadius="8" Margin="6" Height="285" BorderBrush="#7FD51B" BorderThickness="2"><TextBlock Text="ITEM&#10;DESTAQUE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border><Border Background="#171D14" CornerRadius="8" Margin="6" Height="285"><TextBlock Text="CONTEÚDO&#10;NOVO" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border><Border Background="#141A12" CornerRadius="8" Margin="6" Height="285"><TextBlock Text="EM BREVE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border></UniformGrid></StackPanel></Border>
      </StackPanel></Grid></ScrollViewer>

     <Grid x:Name="CatalogPage" Visibility="Collapsed" Margin="42,28,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock Text="Catálogo" FontSize="30" FontWeight="Bold"/><TextBlock Text="Escolha e instale conteúdo autorizado" Foreground="#A5ACB7" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="▣  Abrir pasta de instalação" Style="{StaticResource PrimaryButton}" Margin="6"/><Button Content="♟  Abrir suporte" Background="#25CF70" HorizontalContentAlignment="Center" Padding="20,12" Margin="6"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PASTA DE INSTALAÇÃO" Foreground="#969EAA" FontSize="12"/><TextBlock x:Name="InstallPathText" Text="Nenhuma pasta definida" FontWeight="SemiBold" Margin="0,5,0,13"/></StackPanel><Button Grid.Column="1" Content="Alterar pasta" HorizontalContentAlignment="Center" Background="#1B1D21" Padding="20,9" Click="ChooseFolder_Click"/><StackPanel Grid.Row="1"><TextBlock Text="PASTA DE TEMPORÁRIOS" Foreground="#969EAA" FontSize="12"/><TextBlock Text="Padrão do sistema" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button Grid.Row="1" Grid.Column="1" Content="Usar padrão" HorizontalContentAlignment="Center" Background="#1B1D21" Padding="20,9"/></Grid></Border>
      <TextBox Grid.Row="2" Height="45" Padding="15,12" Background="#121417" Foreground="#A7AFBB" BorderBrush="#292D34" Text="Pesquisar no catálogo..."/>
      <UniformGrid Grid.Row="3" Columns="4" Margin="-7,12,-7,0"><Border Style="{StaticResource Card}" Margin="7" BorderBrush="#79D21D" BorderThickness="2"><Grid><Border Margin="9" Background="#17230F" CornerRadius="8"><StackPanel VerticalAlignment="Center"><TextBlock Text="01" FontSize="48" FontWeight="Black" Foreground="#9DFF00" HorizontalAlignment="Center"/><TextBlock Text="Pacote essencial" HorizontalAlignment="Center"/></StackPanel></Border><Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#05080C" CornerRadius="9" Padding="9,5" Margin="8"><TextBlock Text="↓ 290 MB"/></Border></Grid></Border><Border Style="{StaticResource Card}" Margin="7" BorderBrush="#79D21D" BorderThickness="2"><Grid><Border Margin="9" Background="#1D2518" CornerRadius="8"><StackPanel VerticalAlignment="Center"><TextBlock Text="02" FontSize="48" FontWeight="Black" Foreground="#B3FF52" HorizontalAlignment="Center"/><TextBlock Text="Ferramentas" HorizontalAlignment="Center"/></StackPanel></Border><Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#05080C" CornerRadius="9" Padding="9,5" Margin="8"><TextBlock Text="↓ 1,5 GB"/></Border></Grid></Border><Border Style="{StaticResource Card}" Margin="7" BorderBrush="#79D21D" BorderThickness="2"><Grid><Border Margin="9" Background="#152B1D" CornerRadius="8"><StackPanel VerticalAlignment="Center"><TextBlock Text="03" FontSize="48" FontWeight="Black" Foreground="#76F58F" HorizontalAlignment="Center"/><TextBlock Text="Conteúdo gratuito" HorizontalAlignment="Center"/></StackPanel></Border><Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#05080C" CornerRadius="9" Padding="9,5" Margin="8"><TextBlock Text="↓ 980 MB"/></Border></Grid></Border><Border Style="{StaticResource Card}" Margin="7" BorderBrush="#79D21D" BorderThickness="2"><Grid><Border Margin="9" Background="#242B17" CornerRadius="8"><StackPanel VerticalAlignment="Center"><TextBlock Text="04" FontSize="48" FontWeight="Black" Foreground="#D0FF4C" HorizontalAlignment="Center"/><TextBlock Text="Biblioteca pessoal" HorizontalAlignment="Center"/></StackPanel></Border><Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#05080C" CornerRadius="9" Padding="9,5" Margin="8"><TextBlock Text="↓ 1 GB"/></Border></Grid></Border></UniformGrid>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0"><Button Content="Anterior" Background="#14161A" HorizontalContentAlignment="Center"/><Button Content="1" Style="{StaticResource PrimaryButton}" Margin="8,0"/><Button Content="2" Background="#17191D" HorizontalContentAlignment="Center"/><Button Content="Próxima" Background="#1A1C20" HorizontalContentAlignment="Center" Margin="8,0,0,0"/></StackPanel>
     </Grid>

     <Grid x:Name="DownloadsPage" Visibility="Collapsed" Margin="42,28,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Downloads" FontSize="30" FontWeight="Bold"/><TextBlock Text="Acompanhe instalações, filas e atualizações" Foreground="#A5ACB7" Margin="0,4,0,20"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="24"><StackPanel><TextBlock Text="Nenhum download ativo" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Selecione um item no catálogo para iniciar. Downloads usam HTTPS e são verificados antes da instalação." Foreground="#AAB2BE" Margin="0,8,0,24"/><ProgressBar Height="8" Value="0" Foreground="#9DFF00"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="Pausar" IsEnabled="False"/><Button Content="Cancelar" IsEnabled="False"/></StackPanel></StackPanel></Border></Grid>
     <Grid x:Name="PlaceholderPage" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PlaceholderTitle" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Módulo preparado para conexão com a API própria." Foreground="#9DA5B2" Margin="0,10"/></StackPanel></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
